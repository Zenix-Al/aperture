{
  "name": "aperture",
  "version": "1.0.0",
  "scripts": {
    "build": "node build.js",
    "build:no-bump": "node build.js --no-bump",
    "build:release": "node build.js --release",
    "build:release:no-bump": "node build.js --release --no-bump",
    "build:quick": "npm run build:release && npm run build:addons:release",
    "build:addons": "node addons/build-addon.js --all",
    "build:addons:no-bump": "node addons/build-addon.js --all --force --no-bump",
    "build:addons:release": "node addons/build-addon.js --all --release",
    "build:addons:force": "node addons/build-addon.js --all --force",
    "build:addons:release:force": "node addons/build-addon.js --all --release --force",
    "lint:addons": "eslint \"addons/*/src/**/*.js\" \"addons/shared/**/*.js\" --ext .js",
    "audit:addons": "node scripts/addon-baseline.cjs --output .artifacts/audits/addon-baseline.json",
    "check:addons:baseline": "node scripts/addon-baseline.cjs --check audits/addon-baseline.json",
    "audit:addons:api": "node scripts/addon-api-audit.cjs",
    "check:addons:api": "node scripts/addon-api-audit.cjs --check",
    "audit:addons:size": "node scripts/addon-service-size-audit.cjs --output .artifacts/audits/addon-service-size-audit.json --markdown .artifacts/audits/addon-service-size-audit.md",
    "check:addons:size": "node scripts/addon-service-size-audit.cjs --check audits/addon-service-size-audit.json",
    "check:addons:manifest": "node scripts/addon-catalog.cjs --check-manifest",
    "check:addons:structure": "node scripts/addon-build-tools.cjs --check-structure",
    "generate:addons:catalog": "node scripts/addon-catalog.cjs --write",
    "check:addons:catalog": "node scripts/addon-catalog.cjs --check",
    "check:addons": "npm run lint:addons && npm run check:addons:manifest && npm run check:addons:catalog && npm run check:addons:structure && npm run build:addons:smoke",
    "build:addons:smoke": "node scripts/addon-build-tools.cjs --all --regular --release",
    "build:addons:smoke:regular": "node scripts/addon-build-tools.cjs --all --regular",
    "build:addons:smoke:release": "node scripts/addon-build-tools.cjs --all --release",
    "lint": "eslint \"src/**\" --ext .js",
    "lint:fix": "eslint \"src/**\" --ext .js --fix",
    "test": "node tests/run.cjs && node --test tests/project-build.test.cjs tests/core-contract.test.cjs tests/runtime.test.cjs tests/storage.test.cjs tests/theme.test.cjs tests/addon-platform.test.cjs tests/reading-desk.test.cjs tests/release-audit.test.cjs",
    "test:visual": "node --test tests/core-contract-browser.test.cjs tests/runtime-browser.test.cjs tests/storage-browser.test.cjs tests/theme-browser.test.cjs tests/addon-platform-browser.test.cjs tests/reading-desk-browser.test.cjs",
    "check:manifest": "node scripts/check-feature-manifest.cjs",
    "check:docs": "node scripts/check-docs.cjs",
    "check:inventory": "node scripts/check-inventory.cjs",
    "build:smoke": "node build.js --smoke",
    "audit:core": "node scripts/core-source-audit.cjs --output .artifacts/audits/core-size-baseline.json",
    "audit:core:size-reduction": "node scripts/core-source-audit.cjs --reduction --output .artifacts/audits/core-size-reduction-current.json --compare audits/core-size-reduction-baseline.json",
    "audit:css": "node scripts/css-audit.cjs --output .artifacts/audits/css-audit.json",
    "build:core:smoke": "node scripts/core-source-audit.cjs --smoke-build",
    "check:core": "node scripts/core-source-audit.cjs --check audits/core-size-baseline.json",
    "check:core:size-reduction": "node scripts/core-source-audit.cjs --reduction --check audits/core-size-reduction-current.json --compare audits/core-size-reduction-baseline.json",
    "check:css": "node scripts/css-audit.cjs --check audits/css-audit.json",
    "test:project": "node --test tests/project-build.test.cjs",
    "generate:project:manifest": "node -e \"require('./scripts/featureManifest.cjs').generateProjectFeatureManifest()\"",
    "build:bump": "node build.js --bump",
    "build:addons:bump": "node addons/build-addon.js --all --bump",
    "test:core:browser": "node --test tests/core-contract-browser.test.cjs",
    "test:runtime": "node --test tests/runtime.test.cjs",
    "test:runtime:browser": "node --test tests/runtime-browser.test.cjs",
    "check:project:manifest": "node scripts/check-feature-manifest.cjs",
    "test:storage": "node --test tests/storage.test.cjs",
    "test:storage:browser": "node --test tests/storage-browser.test.cjs",
    "test:theme": "node --test tests/theme.test.cjs",
    "test:theme:browser": "node --test tests/theme-browser.test.cjs",
    "test:addons:platform": "node --test tests/addon-platform.test.cjs",
    "test:addons:platform:browser": "node --test tests/addon-platform-browser.test.cjs",
    "demo:reading": "node scripts/reading-desk.cjs",
    "test:example": "node --test tests/reading-desk.test.cjs",
    "test:example:browser": "node --test tests/reading-desk-browser.test.cjs",
    "test:browser": "node --test tests/core-contract-browser.test.cjs tests/runtime-browser.test.cjs tests/storage-browser.test.cjs tests/theme-browser.test.cjs tests/addon-platform-browser.test.cjs tests/reading-desk-browser.test.cjs",
    "test:core": "node --test tests/core-contract.test.cjs",
    "check:all": "node scripts/run-checks.cjs tests && node scripts/run-checks.cjs static"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-userscripts": "^0.5.6",
    "globals": "^16.3.0",
    "happy-dom": "^17.6.3",
    "prettier": "^3.6.2",
    "terser": "^5.46.1"
  },
  "description": "Framework for building project-specific userscripts with preserved lifecycle, storage, UI and add-on infrastructure",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true
}
